{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start FastAPI Backend Server",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "uvicorn",
        "backend.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Pytest Suite",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "backend/tests/",
        "-v"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start Next.js Frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}
