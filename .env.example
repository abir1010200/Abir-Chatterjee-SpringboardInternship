# =================================================================
# AI-Powered Smart Irrigation System - Environment Configuration
# =================================================================

# Backend & Ingestion API
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL / TimescaleDB)
# Default for Docker container setup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_irrigation
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_irrigation

# MQTT Broker (Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=farm/+/field/+/sensor/+/reading
MQTT_CLIENT_ID=smart_irrigation_subscriber

# Weather API Integrations
# Sign up at https://openweathermap.org/api to obtain a free API key
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Optional fallback provider: https://www.tomorrow.io/
TOMORROW_API_KEY=your_tomorrow_api_key_here
WEATHER_POLL_INTERVAL_MINUTES=30
WEATHER_CACHE_TTL_MINUTES=60

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SmartIrrigate AI
PORT=3000
